# Aggressive .gitignore
# Ignore everything by default, then explicitly unignore useful files/folders below
*

# Keep these repository files tracked
!.gitignore
!README.md
!package.json
!bun.lock
!turbo.json
!.npmrc

# Keep source trees
!apps/
!packages/
!apps/**/*
!packages/**/*

# Re-ignore common unwanted folders and files (ensure they remain ignored inside apps/ and packages/)
node_modules/
**/node_modules/
.env
.env.*
generated/
**/generated/
.agents/
.claude/
.windsurf/
coverage/
coverage/**
dist/
build/
out/
.next/
.turbo/
.vercel/
*.log
logs
*.tgz
*.pem
*.lcov
.idea/
.vscode/
.DS_Store
skills-lock.json

# End of .gitignore
